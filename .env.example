DATABASE_URL=
SECRET_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# LibreOffice, used to convert Office documents to PDF before processing.
# Leave SOFFICE_CMD empty to auto-detect. On Windows this must be soffice.com,
# not soffice.exe - the .exe detaches and reports success before finishing.
SOFFICE_CMD=
ENABLE_FILE_CONVERSION=true
MAX_UPLOAD_MB=200
MAX_CONVERT_MB=100
