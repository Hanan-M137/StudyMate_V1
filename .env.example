DATABASE_URL=
SECRET_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Optional. A cheaper model for grading written quiz answers and for
# rewriting follow-up questions. Unset means CLAUDE_MODEL is used.
CLAUDE_FAST_MODEL=

# Optional. Full path to tesseract.exe on Windows, e.g.
# C:\Program Files\Tesseract-OCR\tesseract.exe . Leave empty on
# Linux/macOS where it is on PATH.
TESSERACT_CMD=

# LibreOffice, used to convert Office documents to PDF before processing.
# Leave SOFFICE_CMD empty to auto-detect. On Windows this must be soffice.com,
# not soffice.exe - the .exe detaches and reports success before finishing.
SOFFICE_CMD=
ENABLE_FILE_CONVERSION=true
MAX_UPLOAD_MB=200
MAX_CONVERT_MB=100

# Email verification for new accounts. Needs SMTP_HOST and SMTP_PASSWORD
# below; without them it stays off and a warning is logged at startup.
REQUIRE_EMAIL_VERIFICATION=false

# Contact form. Messages are always stored in the database; these
# settings only control the notification email. Leave SMTP_PASSWORD
# empty and the feature still works, silently skipping the email.
#
# SMTP_PASSWORD is a Google App Password (16 characters), not the
# account password. It requires 2-step verification on that account.
CONTACT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
